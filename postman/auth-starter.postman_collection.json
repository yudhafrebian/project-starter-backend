    {
      "name": "Lupa Password",
      "description": "Urutan: Forgot Password → tempel link dari email ke `resetToken` → Reset Password. Memakai `registerEmail` supaya akun admin tidak ikut ter-reset.",
      "item": [
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/forgot-password",
            "description": "Selalu 202 dengan body yang sama. Email reset hanya terkirim jika akun ada, aktif, dan lewat 60 detik dari permintaan terakhir.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "pm.test('code reset_email_sent', () => pm.expect(pm.response.json().code).to.eql('reset_email_sent'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/reset-password",
            "description": "Pertama: 200, semua sesi user dicabut, email 'password diganti' terkirim. Token yang sama lagi: 400.\n\nSetelah 200, `registerPassword` otomatis diganti ke password baru.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{resetNewPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.collectionVariables.get('resetToken');",
                  "if (!t) console.warn('resetToken kosong: tempel link dari email ke collection variable.');",
                  "if (t && t.includes('token=')) {",
                  "  pm.collectionVariables.set('resetToken', decodeURIComponent(t.split('token=')[1].split('&')[0]));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 atau 400 (token sudah dipakai)', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('code password_reset', () => pm.expect(pm.response.json().code).to.eql('password_reset'));",
                  "  const oldPw = pm.collectionVariables.get('registerPassword');",
                  "  pm.collectionVariables.set('registerPassword', pm.collectionVariables.get('resetNewPassword'));",
                  "  pm.collectionVariables.set('resetNewPassword', oldPw);",
                  "} else {",
                  "  pm.test('error invalid_reset_token', () => pm.expect(pm.response.json().error.code).to.eql('invalid_reset_token'));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
