        {
          "name": "Update Profil - Avatar",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "avatarUrl wajib https (maks. 2048 karakter).",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avatarUrl\": \"{{avatarUrl}}\"\n}",
              "options": {
                "raw": {
