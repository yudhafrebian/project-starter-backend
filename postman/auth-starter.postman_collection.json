{
  "info": {
    "name": "Auth Starter API",
    "description": "Koleksi endpoint project-starter-backend. Dokumentasi lengkap: doc/15-testing.md#postman dan doc/10-referensi-api.md.\n\nCara pakai:\n1. Tab Variables: sesuaikan `baseUrl` dengan PORT server, isi `email`/`password` (akun terverifikasi, mis. super admin dari seed) dan `registerEmail` (email asli yang inbox-nya bisa dibuka).\n2. Header `X-Requested-With` dipasang otomatis untuk semua request (wajib untuk lolos proteksi CSRF).\n3. Cookie `access_token` & `refresh_token` disimpan otomatis oleh Postman setelah login.\n\nLogin di folder mana pun mengganti sesi aktif di cookie Postman. Folder Admin butuh login sebagai SUPER_ADMIN (request 'Login sebagai Admin' di folder itu).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "email",
      "value": "admin@example.com"
    },
    {
      "key": "password",
      "value": "ganti-password-ini"
    },
    {
      "key": "newPassword",
      "value": "password-baru-minimal-12"
    },
    {
      "key": "registerName",
      "value": "User Tes"
    },
    {
      "key": "registerEmail",
      "value": "email-asli-kamu@gmail.com"
    },
    {
      "key": "registerPassword",
      "value": "password-tes-12345"
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "resetNewPassword",
      "value": "password-reset-12345"
    },
    {
      "key": "googleIdToken",
      "value": ""
    },
    {
      "key": "profileName",
      "value": "Nama Baru"
    },
    {
      "key": "avatarUrl",
      "value": "https://example.com/avatar.png"
    },
    {
      "key": "adminSearch",
      "value": ""
    },
    {
      "key": "targetUserId",
      "value": ""
    },
    {
      "key": "currentRefreshToken",
      "value": ""
    },
    {
      "key": "previousRefreshToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Requested-With', value: 'XMLHttpRequest' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health",
        "description": "Cek server dan koneksi database. Di luar /api/v1, tidak butuh header CSRF."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('db up', () => pm.expect(pm.response.json().db).to.eql('up'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register & Verifikasi",
      "description": "Urutan: Register → Login (Belum Verifikasi) → tempel link dari email ke `verificationToken` → Verify Email → Login (Akun Baru).",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Selalu 202 dengan body yang sama (anti user enumeration). Cek inbox `registerEmail`.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{registerName}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "pm.test('code registration_received', () => pm.expect(pm.response.json().code).to.eql('registration_received'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Belum Verifikasi)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Akun baru yang belum klik link verifikasi. Harus 403 email_not_verified.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));",
                  "pm.test('error email_not_verified', () => pm.expect(pm.response.json().error.code).to.eql('email_not_verified'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/verify-email",
            "description": "Isi `verificationToken` dengan link dari email (boleh seluruh URL). Pertama: 200. Token yang sama lagi: 400.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.collectionVariables.get('verificationToken');",
                  "if (!t) console.warn('verificationToken kosong: tempel link dari email ke collection variable.');",
                  "if (t && t.includes('token=')) {",
                  "  pm.collectionVariables.set('verificationToken', decodeURIComponent(t.split('token=')[1].split('&')[0]));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 atau 400 (token sudah dipakai)', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('code email_verified', () => pm.expect(pm.response.json().code).to.eql('email_verified'));",
                  "} else {",
                  "  pm.test('error invalid_verification_token', () => pm.expect(pm.response.json().error.code).to.eql('invalid_verification_token'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend Verification",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/resend-verification",
            "description": "Selalu 202. Email hanya terkirim jika akun ada, aktif, belum terverifikasi, dan lewat 60 detik dari kiriman terakhir. Link sebelumnya otomatis tidak berlaku.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "pm.test('code verification_sent', () => pm.expect(pm.response.json().code).to.eql('verification_sent'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Akun Baru)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Login akun hasil register setelah diverifikasi. Harus 200.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('code login_success', () => pm.expect(pm.response.json().code).to.eql('login_success'));",
                  "if (pm.cookies.has('refresh_token')) {",
                  "  pm.collectionVariables.set('previousRefreshToken', '');",
                  "  pm.collectionVariables.set('currentRefreshToken', pm.cookies.get('refresh_token'));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sesi",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('code login_success', () => pm.expect(pm.response.json().code).to.eql('login_success'));",
                  "pm.test('access_token cookie diset', () => pm.expect(pm.cookies.has('access_token')).to.be.true);",
                  "pm.test('refresh_token cookie diset', () => pm.expect(pm.cookies.has('refresh_token')).to.be.true);",
                  "if (pm.cookies.has('refresh_token')) {",
                  "  pm.collectionVariables.set('previousRefreshToken', '');",
                  "  pm.collectionVariables.set('currentRefreshToken', pm.cookies.get('refresh_token'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Profil lengkap: emailVerified, hasPassword, providers. Tidak pernah berisi passwordHash."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('tanpa passwordHash', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Rotation: refresh token berganti setiap dipakai."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));",
                  "if (pm.cookies.has('refresh_token')) {",
                  "  pm.collectionVariables.set('previousRefreshToken', pm.collectionVariables.get('currentRefreshToken'));",
                  "  pm.collectionVariables.set('currentRefreshToken', pm.cookies.get('refresh_token'));",
                  "  pm.test('refresh token berganti (rotation)', () => {",
                  "    pm.expect(pm.collectionVariables.get('currentRefreshToken')).to.not.eql(pm.collectionVariables.get('previousRefreshToken'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - Reuse Token Lama (uji pencurian)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Mengirim refresh token yang SUDAH dipakai (variable previousRefreshToken).\n\nLangkah: Login → Refresh → tunggu > 10 detik → jalankan request ini. Hasil benar: 401, dan seluruh sesi dicabut (Refresh biasa setelahnya juga 401).\n\nCookie jar dimatikan supaya yang terkirim benar-benar token lama.",
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token={{previousRefreshToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('previousRefreshToken')) {",
                  "  console.warn('previousRefreshToken kosong: jalankan Login lalu Refresh dulu.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('error invalid_session', () => pm.expect(pm.response.json().error.code).to.eql('invalid_session'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Mencabut sesi perangkat ini. Tidak butuh access token, selalu 204."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout All Devices",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout-all",
            "description": "Mencabut sesi di semua perangkat. Butuh login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Login Google",
      "description": "Cara mendapatkan id_token tanpa frontend (Google OAuth Playground):\n\n1. Di Google Cloud Console, tambahkan `https://developers.google.com/oauthplayground` ke Authorized redirect URIs OAuth Client.\n2. Buka https://developers.google.com/oauthplayground, ikon gear → 'Use your own OAuth credentials', isi Client ID & Secret.\n3. Step 1: ketik `openid email profile`, Authorize APIs, login Google.\n4. Step 2: 'Exchange authorization code for tokens', salin `id_token` (diawali eyJ...).\n5. Tempel ke collection variable `googleIdToken`. Berlaku 1 jam.",
      "item": [
        {
          "name": "Login Google",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/google",
            "description": "Akun Google baru → user dibuat. Pernah login → dikenali lewat sub. Email sudah terdaftar → akun ditautkan (password dihapus jika user belum terverifikasi). Respons sama dengan /login.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"{{googleIdToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.collectionVariables.get('googleIdToken');",
                  "if (!t) {",
                  "  console.warn('googleIdToken kosong: ambil id_token dari OAuth Playground (lihat deskripsi folder).');",
                  "} else {",
                  "  try {",
                  "    const payload = JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "    const sisa = payload.exp - Math.floor(Date.now() / 1000);",
                  "    if (sisa <= 0) console.warn('googleIdToken sudah kedaluwarsa: ambil ulang dari OAuth Playground.');",
                  "    else console.log('googleIdToken untuk ' + payload.email + ', sisa ' + Math.floor(sisa / 60) + ' menit');",
                  "  } catch (e) { console.warn('googleIdToken bukan JWT yang valid'); }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('code login_success', () => pm.expect(pm.response.json().code).to.eql('login_success'));",
                  "  if (pm.cookies.has('refresh_token')) {",
                  "    pm.collectionVariables.set('previousRefreshToken', '');",
                  "    pm.collectionVariables.set('currentRefreshToken', pm.cookies.get('refresh_token'));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Google - Token Palsu",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/google",
            "description": "id_token dengan signature palsu. Harus 401 invalid_google_token.",
